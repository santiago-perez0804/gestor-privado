{
  "name": "fisico-server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch src/index.js",
    "start": "node src/index.js",
    "test": "node --test \"test/*.test.js\" \"../shared/test/*.test.js\"",
    "migrate:ocio": "node src/db/migrations/runOcioV2.js",
    "test:integration": "node --test --test-concurrency=1 \"test/integration/*.test.js\"",
    "migrate:fisico": "node src/db/migrations/runFisicoV2.js"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.12",
    "@vercel/functions": "^3.10.4",
    "cors": "^2.8.5",
    "express": "^4.21.1",
    "multer": "^2.4.0",
    "postgres": "^3.4.9"
  },
  "engines": {
    "node": ">=22.13"
  }
}
