{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm install --prefix server --omit=dev --no-audit --no-fund && npm install --prefix web --include=dev --no-audit --no-fund",
  "buildCommand": "npm run build --prefix web",
  "outputDirectory": "web/dist",
  "regions": ["gru1"],
  "functions": {
    "api/index.mjs": { "maxDuration": 60, "memory": 1024 }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/index.mjs" },
    { "source": "/covers/:path*", "destination": "/api/index.mjs" },
    { "source": "/artworks/:path*", "destination": "/api/index.mjs" },
    { "source": "/certificates/:path*", "destination": "/api/index.mjs" },
    { "source": "/((?!api/|assets/|icons/|sw\\.js|manifest\\.webmanifest|workbox-.*\\.js|widget\\.html|favicon).*)", "destination": "/index.html" }
  ],
  "headers": [
    { "source": "/sw.js", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
    { "source": "/manifest.webmanifest", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
    { "source": "/assets/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy", "value": "same-origin" },
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains" },
        { "key": "Permissions-Policy", "value": "camera=(self), microphone=(), geolocation=()" }
      ]
    }
  ],
  "crons": [{ "path": "/api/cron/daily", "schedule": "0 9 * * *" }]
}
