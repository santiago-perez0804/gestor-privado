# Copiá este archivo como .env (en la raíz del proyecto) y completá lo que uses.
# El .env no se sube al repo. Todas son opcionales: sin una key, esa integración
# queda desactivada y la app sigue funcionando con carga manual.

# ---------- Server ----------
# PORT=4000
# Usuario y contraseña para acceder desde afuera (túnel de cloudflared). Vacío = sin login, y en
# ese caso el server solo atiende a este equipo y la red de la casa: lo que llegue por el túnel se
# rechaza (para que la app nunca quede abierta en internet sin contraseña).
# AUTH_USER=
# AUTH_PASS=

# ---------- Catálogos (Ocio → Agregar) ----------
# TMDB (películas y series). En https://www.themoviedb.org/settings/api → "API Read Access Token" (v4).
TMDB_READ_TOKEN=
# RAWG (videojuegos). En https://rawg.io/apidocs → "Get API key".
RAWG_API_KEY=
# Google Books (libros, opcional: mejora ediciones en español). Google Cloud → APIs → Books API → Credenciales → API key.
GOOGLE_BOOKS_API_KEY=
# Open Library no usa key, pero pide identificarse: un mail de contacto para el User-Agent.
OPENLIBRARY_CONTACT=

# ---------- Google Calendar (Ocio → Salidas) ----------
# Google Cloud → APIs y servicios → Credenciales → ID de cliente OAuth (tipo "Aplicación web").
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Tiene que coincidir con el URI autorizado en la consola de Google.
GOOGLE_REDIRECT_URI=http://localhost:4000/api/google/callback

# Clave para cifrar el token de Google guardado en la base (32 bytes en base64).
# Generala con:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=
